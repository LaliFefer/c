
using System.Collections.Generic;

namespace DalApi
{
    // ממשק גנרי שמגדיר את פעולות ה-CRUD הבסיסיות עבור כל ישות
    // מטרתו לאפשר אחידות: כל ממשק ישות (למשל IProduct) יירש ממנו
    // ולא יגדיר שוב את כותרות המתודות.
    public interface ICrud<T>
        where T : class
    {
        // יצירת ישות חדשה - מחזיר את המזהה שנוצר/הוקצה
        int Create(T item);

        // קריאת ישות לפי מזהה - אם לא נמצא, יחזור null או ערך מתאים
        T Read(int id);

        // החזרת כל הישויות ברשימה
        List<T> ReadAll();

        // עדכון ישות קיימת (לוגיקה של בדיקת קיום נעשית במימוש)
        void Update(T item);

        // מחיקת ישות לפי מזהה
        void Delete(int id);
    }
}
