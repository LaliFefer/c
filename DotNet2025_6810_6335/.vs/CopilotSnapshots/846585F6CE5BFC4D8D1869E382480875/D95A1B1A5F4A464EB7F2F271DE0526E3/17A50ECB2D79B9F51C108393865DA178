// דוגמת תוכנית ראשית לבדיקת ה-DAL
using DalList;
using DalTest;
using DalApi;

// שדה סטטי מרכזי שמכיל את ה-DAL המאוחד, כפי שמבוקש בשלב 4
static readonly IDal s_dal = new DalList.DalList();

// אתחול בסיס הנתונים בעזרת ה-IDal המאוחד
Initialization.Initialize(s_dal);

// שימוש בפונקציות גנריות לעבודה עם ממשקי ICrud<T>
static void PrintAll<T>(ICrud<T> repo, string name) where T : class
{
    var list = repo.ReadAll();
    Console.WriteLine($"{name}: {list.Count}");
}

static void PrintById<T>(ICrud<T> repo, int id, string name) where T : class
{
    var item = repo.Read(id);
    Console.WriteLine($"{name} with id {id}: {item}");
}

static void DeleteById<T>(ICrud<T> repo, int id, string name) where T : class
{
    repo.Delete(id);
    Console.WriteLine($"Deleted {name} with id {id}");
}

// הדפסת סיכום פשוט בעזרת הפונקציות הגנריות
PrintAll(s_dal.Product, "Products");
PrintAll(s_dal.Customer, "Customers");
PrintAll(s_dal.Sale, "Sales");

// דוגמה לקריאה לפי מזהה (מזהה ראשון של מוצר שנוצר)
var products = s_dal.Product.ReadAll();
if (products.Count > 0)
{
    PrintById(s_dal.Product, products[0].IDNumber, "Product");
}
