using System.Collections.Generic;
namespace Dal;
using DO;

internal static class DataSource
{
    // רשימת לקוחות - שם הישות + s, מטיפוס מתאפס (?), סטטית ופנימית
    internal static List<Customer?> Customers = new();

    // רשימת מוצרים
    internal static List<Product?> Products = new();

    // רשימת מכירות
    internal static List<Sale?> Sales = new();

    internal static class Config
    {
        //sale
        internal const int StartSaleId = 1000;

        private static int nextSaleId = StartSaleId;

        internal static int NextSaleId => nextSaleId++;


        // product

        internal const int StartProductId = 100;

        private static int nextProductId = StartProductId;

        internal static int NextProductId => nextProductId++;

    }
}

/* הסבר:
 * DataSource - מחזיקה את "מאגר הנתונים" של השכבה כיחידות זיכרון (רשימות).
 * הרשימות הן static ו-internal כדי שהן יהיו משותפות בתוך פרויקט DalList בלבד.
 * המחלקה הפנימית Config מספקת מספרי רץ (ID generators) עבור ישויות שדורשות מזהה אוטומטי.
 */
